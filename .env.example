# Port server (default 3000)
PORT=3000

# Wajib diganti di produksi. Gunakan string acak panjang (minimal 32 karakter).
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Akun admin. ADMIN_PASSWORD dipakai saat boot pertama dan disinkronkan ke
# database setiap server dijalankan ulang (cara termudah mengganti password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Aktifkan bila server berada di belakang reverse proxy (Nginx/Caddy/Railway/Render).
TRUST_PROXY=0

# Set "production" saat deploy (mengaktifkan CSP ketat/upgrade-insecure-requests).
# NODE_ENV=production

# Paksa atribut Secure pada cookie sesi. Biasanya tidak perlu: aplikasi
# mendeteksinya otomatis saat request HTTPS / di belakang reverse proxy HTTPS.
# COOKIE_SECURE=1

# Lokasi penyimpanan file database SQLite (opsional).
# DATA_DIR=C:\data\toko-kopi-rejeki
